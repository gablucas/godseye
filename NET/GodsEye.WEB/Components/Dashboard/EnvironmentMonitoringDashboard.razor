
@using GodsEye.WEB.Model

<div class="dashboard-item">
    <p class="title">Monitoramento de ambientes</p>


    <div class="sector-filter">

        <MudChip T="string" Text="Todos" onclick="() => SelectSector(0)" Variant=@(_selectedSector == 0 ? Variant.Filled : Variant.Outlined) />

        @foreach (var sector in _sector)
        {
            <MudChip T="string" Text="@sector.Name" onclick="() => SelectSector(sector.Id)" Variant=@(_selectedSector == sector.Id ? Variant.Filled : Variant.Outlined) />
        }
    </div>


    <div class="info">
        @foreach (var log in _filteredLogs)
        {
            <div class="info-row">
                <img src="@($"https://localhost:7010/{log.PersonPhoto}")" @onclick="() => DialogWebService.OpenPersonUpdateDialog(log.PersonId, null)" />
                <span class="person" @onclick="() => DialogWebService.OpenPersonUpdateDialog(log.PersonId, null)">@log.Person</span>
                <span class="sector">@log.Sector</span>
                <span class="date">@log.IdentifiedAt</span>
            </div>
        }
    </div>
</div>



