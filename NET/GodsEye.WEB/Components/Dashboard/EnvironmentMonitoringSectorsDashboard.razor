@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Model

<div class="dashboard-item dashboard-item-wide">
    <p class="title">Setores</p>

    <div class="sectors-grid">
        @foreach (var sector in _logs.OrderByDescending(x => x.TotalPerson))
        {
            <div class="sector-card" @onclick="() => DialogWebService.OpenEnvironmentMonitoringSectorDialog(sector.EnvironmentMonitoringLog)">
                <div class="sector-info">
                    <span class="sector-name">@sector.SectorName</span>
                    <span class="sector-count">@sector.TotalPerson</span>
                </div>
                <div class="sector-label">
                    pessoas
                </div>
            </div>
        }
    </div>
</div>



