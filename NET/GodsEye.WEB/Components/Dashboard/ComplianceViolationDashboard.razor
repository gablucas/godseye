@using GodsEye.Shared.Extensions
@using GodsEye.Shared.Response.IncidentRecording


<div class="dashboard-item">
    <p class="title">Violação de compliance</p>


    @* <div class="sector-filter">

        <MudChip T="string" Text="Todos" onclick="() => SelectSector(0)" Variant=@(_selectedSector == 0 ? Variant.Filled : Variant.Outlined) />

        @foreach (var sector in _sector)
        {
            <MudChip T="string" Text="@sector.Name" onclick="() => SelectSector(sector.Id)" Variant=@(_selectedSector == sector.Id ? Variant.Filled : Variant.Outlined) />
        }
    </div> *@


    <div class="info">
        @foreach (var log in _filteredLogs)
        {
            <div class="info-row">
                <img src="@($"{Configuration["ApiUrl"]}/{log.PersonPhoto}")" @onclick="() => DialogWebService.OpenPersonUpdateDialog(log.PersonId, null)" />
                <span class="primary">@log.PersonName</span>
                <span class="secondary">@log.ViolationType.GetDescription()</span>
                <span class="secondary">@log.PolicyType.GetDescription()</span>
                <span class="tertiary">@log.ExitedAt</span>
            </div>
        }
    </div>
</div>



