@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Shared
@using GodsEye.WEB.Components.StreamCameraComponent


<MudDialog>
    <TitleContent>
        Registro de incidencia
    </TitleContent>


    <DialogContent>
        <div class="container">
            
            <StreamCameraComponent Connection="@Camera?.Connection" />

            <div class="person-list">
                @if (_log is not null)
                {
                    @foreach (var dwellTimeMonitoring in _log)
                    {
                        <div class="person-card">
                            <MudImage src=@($"https://localhost:7010/{dwellTimeMonitoring.ImagePath}") Height="160" Style="border-radius: 7px" />

                            <div class="person-info">
                                <div>
                                    <span>Nome:</span>
                                    <span>@dwellTimeMonitoring.PersonName</span>
                                </div>

                                <div>
                                    <span>Hora entrada:</span>
                                    <span>@dwellTimeMonitoring.EnteredAt</span>
                                </div>

                                <div>
                                    <span>Tempo no ambiente:</span>
                                    <span>@(dwellTimeMonitoring.ExitedAt is not null ? GetDiffHours(dwellTimeMonitoring.EnteredAt, (DateTime)dwellTimeMonitoring.ExitedAt) : GetElapsed(dwellTimeMonitoring.EnteredAt))</span>
                                </div>
                            </div>
                        </div>
                        <MudDivider />
                    }
                    
                }
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Sair</MudButton>
    </DialogActions>
</MudDialog>