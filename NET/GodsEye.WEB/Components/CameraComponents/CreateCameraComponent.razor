@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>

        <div class="form-container">

            <MudForm @ref="form" Model="CameraForm" @bind-IsValid="@success" @bind-Errors="@errors">

                <div class="inputs-container">

                    <MudTextField 
                        Label="Nome" 
                        T="string" 
                        @bind-Value="CameraForm.Name" 
                        For="@(() => CameraForm.Name)" 
                        HelperText="Identificação da câmera" 
                        Required="true" 
                        RequiredError="O nome é obrigatório" 
                        Variant="Variant.Outlined" 
                        />
                    
                    <div class="input-create">
                        <MudSelect 
                            Label="Selecione um setor" 
                            T="int?" 
                            @bind-Value="CameraForm.SectorId" 
                            HelperText="Selecione um setor que será vinculado a câmera" 
                            Required="true"
                            RequiredError="Selecione um setor"
                            Variant="Variant.Outlined">

                            @foreach (var sector in _sectors)
                            {
                                <MudSelectItem T="int?" Value="@sector.Id">@sector.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudButton OnClick="() => DialogWebService.OpenCreateSector(null, CreateNewSectorCallback)" Variant="Variant.Outlined">Criar novo setor</MudButton>
                    </div>

                    <div class="video-inputs">

                        <div class="connection">
                            <MudTextField 
                                Label="Conexão" 
                                T="string" 
                                ValueChanged="OnConnectionChanged"
                                HelperText="IP de conexão para se conectar a camera" 
                                Variant="Variant.Outlined"
                                Required="true"
                                Error="@_hasConnectionError"
                                ErrorText="@_connectionErrorMessage"
                                Disabled="_loadingConnection"
                                />

                            <MudButton 
                                OnClick="StartStream" 
                                Disabled="string.IsNullOrEmpty(CameraForm.Connection) || _loadingConnection"
                                Variant="Variant.Outlined" 
                                Style="height: 56px; margin-top: 8px" 
                                Color="Color.Success"

                                >Testar conexão</MudButton>

                            @if(_loadingConnection) 
                            {
                                <MudProgressLinear Style="grid-column: 1/-1" Color="Color.Primary" Indeterminate="true" Rounded="true" />
                            }

                            <MudCollapse Expanded="_videoExpanded">
                                <video id="camera-player"
                                       controls
                                       autoplay
                                       muted
                                       playsinline
                                       style="width: 100%; max-width: 640px; background: black;">
                                </video>
                            </MudCollapse>
                            
                        </div>
                    </div>
                </div>

                <MudDivider Style="margin: 24px 0px" />

                <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Registrar</MudButton>


                @if (apiResponse is not null && apiResponse == 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Houve um erro ao cadastrar a pessoa, tente novamente mais tarde</MudAlert>
                }


                <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                </MudOverlay>

            </MudForm>

        </div>
      
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>