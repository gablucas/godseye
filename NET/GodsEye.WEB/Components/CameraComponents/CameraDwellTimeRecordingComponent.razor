@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <CameraConfigurationBarComponent Id="Id" Pagina="controle-permanencia" />


        <div class="form-container">

            <MudForm @ref="form" Model="DwellTimeMonitoringForm" @bind-IsValid="@success" @bind-Errors="@errors">

                <div class="inputs-container">

                    <div>
                        <MudTooltip Text="Tempo máximo que a pessoa pode permanecer no ambiente antes de gerar um alerta" Placement="Placement.Top">
                            <MudText Typo="Typo.subtitle2">
                                Tempo máximo de permanência
                            </MudText>
                        </MudTooltip>

                        <MudTextField Label="Tempo"
                                      @bind-Value="DwellTimeMonitoringForm.MaxDwellTime"
                                      T="int"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentText="min"
                                      Style="max-width: 200px;"
                                      For="@(() => DwellTimeMonitoringForm.MaxDwellTime)" />


                    </div>

                    <div>
                        <MudTooltip Text="Tempo máximo que a pessoa pode ficar sem ser identificada pela camera antes de gerar um alerta" Placement="Placement.Top">
                            <MudText Typo="Typo.subtitle2">
                                Tolerância de não identificação
                            </MudText>
                        </MudTooltip>

                        <MudTextField Label="Tempo"
                                      @bind-Value="DwellTimeMonitoringForm.RecognitionGracePeriod"
                                      T="int"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentText="min"
                                      Style="max-width: 200px;"
                                      For="@(() => DwellTimeMonitoringForm.RecognitionGracePeriod)" />
                    </div>
                </div>




                <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Atualizar</MudButton>

                <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                </MudOverlay>

            </MudForm>

        </div>

      
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>