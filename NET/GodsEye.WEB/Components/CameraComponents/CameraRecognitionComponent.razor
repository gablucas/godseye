@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="form-container">
            <MudForm @ref="form" Model="RecognitionForm" @bind-IsValid="@success" @bind-Errors="@errors">

                <div class="video-inputs">
                    <div class="video-wrapper">
                        <video id="camera-player" controls autoplay muted playsinline></video>
                        <canvas id="roiCanvas" style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:10;"></canvas>

                        @if (isDrawingActive)
                        {
                            <div style="position:absolute; top:10px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.7); color:white; padding:5px 10px; border-radius:5px; z-index:20;">
                                @(drawingMode == "rect" ? "Clique e arraste para desenhar o retângulo" : "Clique nos pontos para formar o polígono (Enter para fechar)")
                            </div>
                        }
                    </div>

                    <MudTabs Rounded="true" Border="true" Outlined="true" PanelClass="pa-2" @bind-ActivePanelIndex="activeTabIndex">

                        <MudTabPanel Text="Tamanho Face" OnClick="() => SelectTab(RecognizeRectEnum.Face)">
                            <div class="measure-input">
                                <MudCheckBox @bind-Value="_face" Label="Ativar" Color="Color.Tertiary"></MudCheckBox>

                                <div>
                                    @if (!isDrawingActive)
                                    {
                                        <MudButton Disabled="!_face" OnClick="() => StartDrawingFace()" Variant="Variant.Outlined" Color="Color.Success">
                                            Desenhar Retângulo
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton OnClick="ConfirmDrawing" Variant="Variant.Filled" Color="Color.Primary">Salvar Desenho</MudButton>
                                        <MudButton OnClick="CancelDrawing" Variant="Variant.Outlined" Color="Color.Error">Cancelar</MudButton>
                                    }
                                </div>
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="Área de Reconhecimento" OnClick="() => SelectTab(RecognizeRectEnum.Camera)">
                            <div class="measure-input">
                                <MudCheckBox @bind-Value="_area" Label="Ativar" Color="Color.Tertiary"></MudCheckBox>

                                <div>
                                    @if (!isDrawingActive)
                                    {
                                        <MudButton Disabled="!_area" OnClick="() => StartDrawingArea()" Variant="Variant.Outlined" Color="Color.Success">
                                            Desenhar Polígono
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton OnClick="ConfirmDrawing" Variant="Variant.Filled" Color="Color.Primary">Salvar Desenho</MudButton>
                                        <MudButton OnClick="UndoLastPoint" Variant="Variant.Filled" Color="Color.Secondary">Desfazer</MudButton>
                                        <MudButton OnClick="CancelDrawing" Variant="Variant.Outlined" Color="Color.Error">Cancelar</MudButton>
                                    }
                                </div>
                            </div>
                        </MudTabPanel>

                    </MudTabs>
                </div>
            </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>