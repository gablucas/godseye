@using GodsEye.Application.DTOs.Model
@using GodsEye.Domain.Enums
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <CameraConfigurationBarComponent Id="Id" Pagina="reconhecimento" />

        <div class="form-container">

            <div class="menu">
                <div class="item @(activeContext == RoiTypeEnum.FaceDetection ? "selected" : "")" @onclick="() => SelectTab(RoiTypeEnum.FaceDetection)">
                    <MudIcon Icon="@Icons.Material.Filled.Face" />
                    <span>Face</span>
                </div>

                <div class="item @(activeContext == RoiTypeEnum.RestrictedArea ? "selected" : "")" @onclick="() => SelectTab(RoiTypeEnum.RestrictedArea)">
                    <MudIcon Icon="@Icons.Material.Filled.AreaChart" />
                    <span>Área</span>
                </div>

                <MudDivider Vertical="true" Style="margin: 0px 40px" />


                @if (!isDrawingActive)
                {
                    <div class="item" @onclick="() => StartDrawingFace(activeContext)">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                        <span>Desenhar</span>
                    </div>
                }
                else
                {
                    <div class="item" @onclick="ConfirmDrawing">
                        <MudIcon Icon="@Icons.Material.Filled.Done" />
                        <span>Confirmar</span>
                    </div>


                    if (activeContext == RoiTypeEnum.RestrictedArea)
                    {
                        <div class="item" @onclick="UndoLastPoint">
                            <MudIcon Icon="@Icons.Material.Filled.Undo" />
                            <span>Desfazer</span>
                        </div>
                    }

                    <div class="item" @onclick="() => CancelDrawing(activeContext)">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" />
                        <span>Cancelar</span>
                    </div>
                }

                <MudDivider Vertical="true" Style="margin: 0px 40px" />

                @if (!isDrawingActive && (activeContext == RoiTypeEnum.FaceDetection && FaceRoi.Coordinates.Points.Count() > 0) || (activeContext == RoiTypeEnum.RestrictedArea && EnvironmentRoi.Coordinates.Points.Count() > 0))
                {
                    <div class="item" @onclick="() => Submit(activeContext)">
                        <MudIcon Icon="@Icons.Material.Filled.Save" />
                        <span>Salvar</span>
                    </div>
                }
                

                @if (activeContext == RoiTypeEnum.FaceDetection && FaceRoi.Id > 0 || activeContext == RoiTypeEnum.RestrictedArea && EnvironmentRoi.Id > 0)
                {
                    <div class="item" @onclick="() => Delete(activeContext)">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                        <span>Excluir</span>
                    </div>
                }
            </div>


            <div class="video-inputs mb-4">
                <div class="video-wrapper" style="position: relative;">
                    <video id="camera-player" controls autoplay muted playsinline style="width: 100%; display: block;"></video>
                    <canvas id="roiCanvas" style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:10;"></canvas>
                </div>
            </div>


        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>