<div>
    <MudChip T="string" Size="Size.Large" Style="padding: 8px;" OnClick="() => OpenCameraData(Id)" Label="true" Color=@(Pagina == "dados" ? Color.Success : Color.Default)>
        <MudText Typo="Typo.subtitle1" Class="m-0">
            Dados
        </MudText>
    </MudChip>

    <MudChip T="string" Size="Size.Large" Style="padding: 8px;" OnClick="() => OpenCameraRecognition(Id)" Label="true" Color=@(Pagina == "reconhecimento" ? Color.Success : Color.Default)>
        <MudText Typo="Typo.subtitle1" Class="m-0">
            Reconhecimento
        </MudText>
    </MudChip>

    @if (HasFeature(1))
    {
        <MudChip T="string" Size="Size.Large" Style="padding: 8px;" OnClick="() => OpenEnvironmentMonitoring(Id)" Label="true" Color=@(Pagina == "monitoramento-ambiente" ? Color.Success : Color.Default)>
            <MudText Typo="Typo.subtitle1" Class="m-0">
                Monitoramento de ambientes
            </MudText>
        </MudChip>

    }

    @if (HasFeature(2))
    {
        <MudChip T="string" Size="Size.Large" Style="padding: 8px;" OnClick="() => OpenIncidentRecording(Id)" Label="true" Color=@(Pagina == "registro-incidente" ? Color.Success : Color.Default)>
            <MudText Typo="Typo.subtitle1" Class="m-0">
                Registro de incidentes
            </MudText>
        </MudChip>
    }

    @if (HasFeature(3))
    {
        <MudChip T="string" Size="Size.Large" Style="padding: 8px;" OnClick="() => OpenDwellTimeMonitoring(Id)" Label="true" Color=@(Pagina == "controle-permanencia" ? Color.Success : Color.Default)>
            <MudText Typo="Typo.subtitle1" Class="m-0">
                Controle de permanência
            </MudText>
        </MudChip>
    }
</div>