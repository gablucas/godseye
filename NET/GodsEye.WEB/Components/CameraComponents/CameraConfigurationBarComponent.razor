<div class="camera-bar">

    <div class="item @(Pagina == "dados" ? "selected" : "")" @onclick="() => OpenCameraData(Id)">
        <span>Dados</span>
    </div>

    <div class="item @(Pagina == "reconhecimento" ? "selected" : "")" @onclick="() => OpenCameraRecognition(Id)">
        <span>Reconhecimento</span>
    </div>

    @if (HasFeature(1))
    {
        <div class="item @(Pagina == "monitoramento-ambiente" ? "selected" : "")" @onclick="() => OpenEnvironmentMonitoring(Id)">
            <span>Monitoramento de ambientes</span>
        </div>
    }

    @if (HasFeature(2))
    {
        <div class="item @(Pagina == "registro-incidente" ? "selected" : "")" @onclick="() => OpenIncidentRecording(Id)">
            <span>Registro de incidente</span>
        </div>
    }

    @if (HasFeature(3))
    {
        <div class="item @(Pagina == "controle-permanencia" ? "selected" : "")" @onclick="() => OpenDwellTimeMonitoring(Id)">
            <span>Controle de permanência</span>
        </div>
    }
</div>