@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <CameraConfigurationBarComponent Id="Id" Pagina="registro-incidente" />


        <div class="form-container">

            <MudForm @ref="form" Model="IncidentRecordingForm" @bind-IsValid="@success" @bind-Errors="@errors">

                <div>
                    <MudText Typo="Typo.subtitle2">Identificador da camera</MudText>
                    <MudTextField Style="width: 400px" Label="MacAddress" @bind-Value="IncidentRecordingForm.MacAddress" T="string" For="@(() => IncidentRecordingForm.MacAddress)" Variant="Variant.Outlined" />
                </div>

                <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Atualizar</MudButton>

                <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                </MudOverlay>

            </MudForm>

        </div>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>