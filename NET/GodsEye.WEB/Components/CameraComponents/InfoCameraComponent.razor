@using GodsEye.Shared.Response.Camera


<MudDialog>
    <TitleContent>
        Cameras
    </TitleContent>


    <DialogContent>
        <MudGrid>
            
            <MudItem xs="12">
                <MudGrid>
                    <MudItem xs="6">
                        <video id="camera-player" width="100%" height="100%" controls autoplay></video>
                    </MudItem>

                    <MudItem xs="6">
                        <div class="data-info">
                            <div class="info-container">
                                <span>Camera:</span>
                                <span>@Camera.Name</span>
                            </div>

                            <div class="info-container">
                                <span>Setores:</span>
                                <span>@Camera.SectorName</span>
                            </div>

                            <div class="actions">
                                <MudButton Variant="Variant.Outlined" Color="Color.Success">
                                    Editar Informações
                                </MudButton>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
                
            </MudItem>

            <MudItem xs="12">
                <MudTable T="CameraLogResponse" Elevation="0" @ref="_mudTable" Items="@_log" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
                    <HeaderContent>
                        <MudTh>Setor</MudTh>
                        <MudTh>Data/Hora</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Sector</MudTd>
                        <MudTd DataLabel="Connection">@context.CreatedAt</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
        </MudGrid>
    </DialogContent>


    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>