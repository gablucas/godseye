@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Model

<div class="dashboard-container">
    <MudCard Elevation="0" Outlined="true" Style="width: max-content">
        <MudTable T="EnvironmentMonitoringModel" Style="width: max-content; font-size: 10px" Dense="true" Height="200px" @ref="_mudTable" Items="@_filteredLogs" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
            <HeaderContent>

                <MudTh>Pessoa</MudTh>
                <MudTh>Setor</MudTh>
                <MudTh>Data</MudTh>
            </HeaderContent>
            <RowTemplate>
                @* <MudTd  DataLabel="PersonPhoto"><MudImage Height="40" Style="border-radius: 7px" src=@($"https://localhost:7010/{context.PersonPhoto}") /></MudTd> *@
                <MudTd onclick=@(() => DialogWebService.OpenPersonInfoDialog(context.PersonId)) DataLabel="Person">@context.Person</MudTd>
                <MudTd DataLabel="Name">@context.Sector</MudTd>
                <MudTd DataLabel="Connection">@context.CreatedAt</MudTd>
            </RowTemplate>
        </MudTable>
    </MudCard>
</div>


