@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Helpers

<MudDialog>
    <DialogContent>
        <div class="info-person-container">
            <PersonBarComponent Pagina="dados" PersonId="PersonId" />

            <div>
                <MudImage Height="240" Style="border-radius: 7px" src=@(ImageHelper.HasPersonImage(_personLogs.PersonPhoto)) />
                <CreateOrUpdatePersonComponent PersonId="PersonId" />
            </div>
        </div>
    </DialogContent>


    <DialogActions>
        <MudButton OnClick="Cancel">Fechar</MudButton>
    </DialogActions>
</MudDialog>