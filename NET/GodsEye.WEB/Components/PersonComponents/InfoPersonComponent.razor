@using GodsEye.Application.DTOs.Model

<MudDialog>
    <DialogContent>
        <div class="info-person-container">

            <div>
                <MudImage Height="160" Style="border-radius: 7px" src=@($"https://localhost:7010/{_personLogs.PersonPhoto}") />
                <div class="data-info">
                    <div class="info-container">
                        <span>Nome:</span>
                        <span>@_personLogs.PersonName</span>
                    </div>

                    @* <div class="info-container sectors">
                        <span>Setores:</span>
                        <div>
                            @if (Person.Sectors.Count > 0)
                            {
                                foreach (var sec in Person.Sectors)
                                {
                                    <span>@sec.SectorName</span>
                                }
                            }
                            else
                            {
                                <span>Nenhum setor</span>
                            }
                        </div>
                    </div> *@
                </div>
            </div>

            <div>
                <MudTabs Rounded="true" Elevation="0" Outlined="true" Border="true" ApplyEffectsToContainer="true">

                    <MudTabPanel Text="Registros">
                        <MudTable T="EnvironmentMonitoringLogs" Bordered="true" Elevation="0" Outlined="true" @ref="_mudTable" Items="@_logs" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
                            <HeaderContent>
                                <MudTh>Setor</MudTh>
                                <MudTh>Data/Hora</MudTh>
                                <MudTh>Tempo no setor</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">@context.SectorName</MudTd>
                                <MudTd DataLabel="Connection">@context.CreatedAt</MudTd>
                                <MudTd DataLabel="TimeOnSector">@context.TimeOnSector</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudTabPanel>


                    <MudTabPanel Text="Tab Two">
                        <MudText>Content Two</MudText>
                    </MudTabPanel>
                    <MudTabPanel Text="Tab Three">
                        <MudText>Content Three</MudText>
                    </MudTabPanel>
                    <MudTabPanel Text="Tab Disabled" Disabled="true">
                        <MudText>Content Disabled</MudText>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </div>
    </DialogContent>


    <DialogActions>
        <MudButton OnClick="Cancel">Fechar</MudButton>
    </DialogActions>
</MudDialog>