@using GodsEye.Application.DTOs.Model
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="form-container">
            <MudForm @ref="form" Model="CreateSectorForm" @bind-IsValid="@success" @bind-Errors="@errors">

                <div class="inputs-container">
                    <MudTextField Label="Nome do setor" @bind-Value="CreateSectorForm.Name" Required="true" RequiredError="O nome do setor é obrigatório" T="string" For="@(() => CreateSectorForm.Name)" Variant="Variant.Outlined" />


                    <div class="selected-emails-preview">

                        <div class="input-create">
                            <MudSelect T="int" Label="Grupos de email para notificação" HelperText="Selecione os grupos que irão receber notificaçõe neste setor" MultiSelection="true" @bind-SelectedValues="CreateSectorForm.NotificationGroups" MultiSelectionTextFunc="GetSelectNotificationGroupsName" Variant="Variant.Outlined">
                                @foreach (var notificationGroup in _notificationGroups)
                                {
                                    <MudSelectItem T="int" Value="@notificationGroup.Id">@notificationGroup.Name</MudSelectItem>
                                }
                            </MudSelect>

                            <MudButton @onclick="() => DialogWebService.OpenCreateNotificationGroup(CreateNewEmailGroupCallback)" Variant="Variant.Outlined">Criar novo grupo de email</MudButton>
                        </div>
                        

                        <MudText Typo="Typo.overline" Style="display: block">Emails que receberão a notificação</MudText>

                        @foreach (var group in _notificationGroups.Where(x => CreateSectorForm.NotificationGroups.Contains(x.Id)))
                        {
                            foreach(var email in group.Emails)
                            {
                                <MudChip T="string" Label="true" Variant="Variant.Outlined" Size="Size.Medium" Color="Color.Primary">@email.Name</MudChip>
                            }
                        }
                    </div>
                </div>

                <MudDivider />

                <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Registrar</MudButton>

                <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                </MudOverlay>

            </MudForm>

        </div>
    </DialogContent>


    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>