@using GodsEye.Application.DTOs.Model
@using GodsEye.Domain.Extensions
@using GodsEye.Shared.Enums
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>

        <div class="form-container">

            <MudForm @ref="form" Model="_accessScheduleForm" >

                <div class="inputs-container">
                    <MudTextField Label="Nome"
                        @bind-Value="_accessScheduleForm.Name"
                        T="string"
                        Variant="Variant.Outlined"
                        Required="true" 
                        RequiredError="O nome é obrigatório"
                        For="@(() => _accessScheduleForm.Name)" />

                    <div class="select-weekdays">
                        @foreach (var day in Enum.GetValues<WeekDayEnum>())
                        {
                            <div>
                                <MudSwitch Value="_selectedWeekDays.Contains(day)" ValueChanged="@((bool value) => ToogleWeekDay(day))" Label="@day.GetDescription()" Color="Color.Primary" />
                            </div>
                        }
                    </div>

                    <div class="week-days">

                        @foreach (var day in _selectedWeekDays.Order())
                        {
                            <div class="day" @key="day">
                                <div class="menu">
                                    <div class="title">
                                        <MudIcon Icon="@Icons.Material.Outlined.Today" />
                                        <span>@day.GetDescription()</span>
                                    </div>

                                    <div class="action">
                                        <MudMenu Label="Copiar de" Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Outlined" TransformOrigin="Origin.TopCenter">
                                            @foreach (var dayOption in _accessScheduleForm.Rules.Where(x => x.WeekDay != day && x.StartTime != TimeSpan.Zero && x.EndTime != TimeSpan.Zero).DistinctBy(x => x.WeekDay))
                                            {
                                                <MudMenuItem Label="@dayOption.WeekDay.GetDescription()" OnClick="() => CopyAccessSchedule(day, dayOption.WeekDay)" />
                                            }
                                        </MudMenu>
                                    </div>
                                </div>
                                
                                <div class="times">

                                    @foreach (var (rule, index) in _accessScheduleForm.Rules.Where(x => x.WeekDay == day).ToList().Select((rule, index) => (rule, index)))
                                    {
                                        <div class="time" @key="rule">
                                            <MudIcon Icon="@Icons.Material.Outlined.Delete" @onclick="() => RemoveRule(day, rule)" Style="color: var(--gray-100)" />

                                            <MudTimePicker 
                                                Editable="false" 
                                                Time="rule.StartTime"
                                                TimeChanged="@(value => OnTimeChanged(value, rule, day, "start"))" 
                                                Error=@(HasError(index, day, "start")) 
                                                Variant="Variant.Outlined"
                                                />

                                            <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Style="color: var(--gray-050)" />

                                            <MudTimePicker 
                                                Editable="false" 
                                                Time="rule.EndTime"
                                                TimeChanged="@(value => OnTimeChanged(value, rule, day, "end"))"
                                                Error=@(HasError(index, day, "end")) 
                                                Variant="Variant.Outlined" 
                                                />

                                            @if (_timeRuleErrors.Any(rule => rule.Day == day && rule.Index == index && rule.Message is not null && (rule.IsStartTimeWrong || rule.IsEndTimeWrong))) 
                                            {
                                                <p class="time-error">@_timeRuleErrors.First(rule => rule.Day == day && rule.Index == index).Message</p>
                                            }
                                            
                                        </div>
                                    }
                                </div>

                                <MudButton Variant="Variant.Outlined" OnClick="() => AddNewRule(day)">
                                    <MudIcon Icon="@Icons.Material.Rounded.Add" />
                                    <span>Adicionar</span>
                                </MudButton>
                            </div>
                        }

                    </div>
                </div>


                <MudButton OnClick="Submit" Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">@(Id == 0 ? "Criar" : "Atualizar")</MudButton>

                <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                </MudOverlay>

            </MudForm>

        </div>

      
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>