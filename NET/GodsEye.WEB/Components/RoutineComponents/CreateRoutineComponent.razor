@using GodsEye.Application.DTOs.Model
@using GodsEye.Domain.Enums
@using GodsEye.Domain.Extensions
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="form-container">
            <MudForm @ref="form" Model="RoutineForm" @bind-Errors="@errors">

                <div class="inputs-container">
                    <MudTextField 
                        Label="Nome da rotina" 
                        @bind-Value="RoutineForm.Name" 
                        Required="true" 
                        RequiredError="O nome da rotina é obrigatório" 
                        T="string" 
                        For="@(() => RoutineForm.Name)" Variant="Variant.Outlined" />


                    
                    <MudSelect Label="Tipo de regra"
                                T="RoutineRuleTypeEnum"
                                @bind-Value="RoutineForm.RuleType"
                                Required="true"
                                RequiredError="Selecione um setor"
                                Variant="Variant.Outlined">
                        @foreach (var tipo in Enum.GetValues<RoutineRuleTypeEnum>())
                        {
                            <MudSelectItem T="RoutineRuleTypeEnum" Value="@tipo">@tipo.GetDescription()</MudSelectItem>
                        }
                    </MudSelect>

                    @if (RoutineForm.RuleType == RoutineRuleTypeEnum.SectorTransition)
                    {
                        <MudChip T="string" Label="true" Variant="Variant.Outlined" Color="Color.Info" Style="width: 100%; margin: 0px; margin-top: 4px; margin-bottom: 24px" Icon="@Icons.Material.Filled.LabelImportant">A regra Transição de Setor permite especificar um ou mais setores em sequencia onde a pessoa deve estar</MudChip>
                    }

                <div class="rules">
                    @foreach (var routine in RoutineForm.Rules.OrderBy(x => x.OrderIndex))
                    {
                        @if (RoutineForm.RuleType == RoutineRuleTypeEnum.SectorTransition)
                        {
                            <div class="rule">

                                <div class="position">
                                    <MudIcon @onclick=@(() => ChangeRulePosition(routine, "UP")) Icon="@Icons.Material.Filled.ArrowCircleUp" />
                                    <MudIcon @onclick=@(() => ChangeRulePosition(routine, "DOWN")) Icon="@Icons.Material.Filled.ArrowCircleDown" />
                                </div>

                                <span class="order-index">@routine.OrderIndex</span>

                                <div class="input-sector">
                                        <MudSelect T="int?"
                                                   @bind-Value="routine.SectorId"
                                                   For="@(() => routine.SectorId)"
                                                   Required="true"
                                                   Validation="@( (int? value) => ValidateSector(routine, value) )"
                                                   Label="Setor"
                                                   Variant="Variant.Outlined">

                                        @foreach (var sector in _sectors)
                                        {
                                                <MudSelectItem T="int?"
                                                               Value="@sector.Id"
                                                               Disabled="@RoutineForm.HasSector(sector.Id, routine)">
                                                    @sector.Name
                                                </MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudButton Style="height: 56px; margin-top: 8px" OnClick="() => DialogWebService.OpenCreateSector(CreateNewSectorCallback)" Variant="Variant.Outlined">Criar novo setor</MudButton>
                                </div>

                                    <MudNumericField @bind-Value="routine.MinTime" Label="Tempo mínimo" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="minutos" Min="0" HideSpinButtons="true" />
                                    <MudNumericField @bind-Value="routine.MaxTime" Label="Tempo máximo" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="minutos" Min="0" Max="59" HideSpinButtons="true" />


                                    <MudIcon Class="delete" @onclick=@(() => DeleteRule(routine)) Icon="@Icons.Material.Filled.Delete" />
                            </div>
                        }
                    }
                        <MudButton Variant="Variant.Outlined" OnClick=AddNewRule>
                            <MudIcon Icon="@Icons.Material.Rounded.Add" />
                            <span>Adicionar nova regra</span>
                        </MudButton>

                    </div>
                </div>

                <MudDivider />

                <MudButton OnClick="Submit" Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Registrar</MudButton>

                <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                </MudOverlay>

            </MudForm>

        </div>
    </DialogContent>


    <DialogActions>
        <MudButton OnClick="Cancel">Sair</MudButton>
    </DialogActions>
</MudDialog>