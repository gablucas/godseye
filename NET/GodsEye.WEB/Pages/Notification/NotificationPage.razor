@page "/notificacao/emails"
@using GodsEye.WEB.Components
@using GodsEye.WEB.Enum
@using GodsEye.Application.DTOs.Model;


<PageTitle>Notificações</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">
        <div class="page-title">
            <h1>Notificações</h1>
            <p>Configure as notificações de seu sistema</p>
        </div>

        <div class="notification-menu">
            <div class="filters">
                <div class="option">
                    <MudTextField @bind-Value="_groupNameFilter" TextChanged="ApplyFilters" Immediate="true" Label="Grupo" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>

                <div class="option">
                    <MudTextField @bind-Value="_grouEmailFilter" TextChanged="ApplyFilters" Immediate="true" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>
            </div>

            <MudButton Variant="Variant.Outlined" OnClick="() => DialogWebService.OpenCreateNotificationGroup(null)">Criar grupo de notificação</MudButton>
        </div>

        <MudTable T="NotificationGroupModel" @ref="_mudTable" Items="@_filteredLogs" Elevation="0" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh>Grupo</MudTh>
                <MudTh>Emails</MudTh>
                <MudTh>Editar</MudTh>
                <MudTh>Excluir</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="padding: 16px" DataLabel="Person">@context.Name</MudTd>

                <MudTd Style="padding: 16px" DataLabel="Name">
                    @foreach (var email in context.Emails.Where(x => String.IsNullOrWhiteSpace(x.Name) || x.Name.Contains(_grouEmailFilter, StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudChip T="string" Label="true" Variant="Variant.Outlined" Size="Size.Medium" Color="Color.Primary">@email.Name</MudChip>
                    }
                </MudTd>
                <MudTd><MudButton OnClick="() => OpenUpdateNotificationGroup(context)" Variant="Variant.Outlined" Size="Size.Small">Editar</MudButton></MudTd>
                <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error">Excluir</MudButton></MudTd>
            </RowTemplate>
        </MudTable>

    </div>

</div>