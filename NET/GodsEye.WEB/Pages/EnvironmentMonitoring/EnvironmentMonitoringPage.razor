@page "/monitoramento-de-ambientes/tempo-real"
@using GodsEye.Shared.Response.EnvironmentMonitoring
@using GodsEye.WEB.Model


<PageTitle>Monitoramento de ambientes</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">

        <div class="page-title">
            <h1>Monitoramento de ambientes</h1>
        </div>

        <div class="notification-menu">
            <div class="filters">

                <div class="option">
                    <MudTextField @bind-Value="_personFilter" TextChanged="ApplyFilters" Immediate="true" Label="Pessoa" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>

                <div class="option">
                    <MudSelect T="string" SelectedValuesChanged="OnSectorsChanged" SelectedValues="_selectedSectors" MultiSelection="true" SelectAll="true" SelectAllText="Selecionar tudo" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetMultiSelectionText))" Label="Setores" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var sector in _sectors)
                        {
                            <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="option">
                    <MudSelect T="string" Label="Filtro rápido - Data" @bind-Value="_selectedFilterData" SelectedValuesChanged="PreDateFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" OnClearButtonClick="CleanPreFiltred">

                        @foreach (var preFiltro in _preFiltersData)
                        {
                            <MudSelectItem T="string" Value="@preFiltro">
                                @preFiltro
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="option">
                    <MudDatePicker @ref="_initialDatePicker"
                                   DateChanged="OnInitialDateChanged"
                                   Label="Data inicial"
                                   Editable="true"
                                   Mask="@(new DateMask("dd/MM/yyyy"))"
                                   DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"               
                                   />

                </div>

                <div class="option">
                    <MudDatePicker @ref="_finalDatePicker"
                                   DateChanged="OnFinalDateChanged"
                                   Label="Data final"
                                   Editable="true"
                                   Mask="@(new DateMask("dd/MM/yyyy"))"
                                   DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true" 
                                   />
                </div>

            </div>
        </div>
        

        <MudTable T="EnvironmentMonitoringLogResponse" @ref="_mudTable" Elevation="0" Items="@_filteredLogs" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh></MudTh>
                <MudTh>Pessoa</MudTh>
                <MudTh>Setor</MudTh>
                <MudTh>Data/Hora</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd onclick=@(() => DialogWebService.OpenPersonUpdateDialog(context.PersonId, null)) Style="padding: 4px 16px" DataLabel="PersonPhoto"><MudImage Height="40" Style="border-radius: 7px" src=@($"https://localhost:7010/{context.PersonPhoto}") /></MudTd>
                <MudTd Style="padding: 4px 16px" DataLabel="Person">@context.Person</MudTd>
                <MudTd Style="padding: 4px 16px" DataLabel="Name">@context.Sector</MudTd>
                <MudTd Style="padding: 4px 16px" DataLabel="Connection">@context.IdentifiedAt</MudTd>
            </RowTemplate>
        </MudTable>

        <MudMenu Label="DEV MENU" Class="dev-menu" Color="Color.Tertiary" Size="Size.Large" Variant="Variant.Outlined" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight">
            <MudMenuItem Label="Excluir tudo" OnClick="DeleteAll" />
        </MudMenu>
    </div>
</div>

