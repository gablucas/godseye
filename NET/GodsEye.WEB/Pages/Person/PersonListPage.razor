@page "/pessoas";
@using GodsEye.Application.DTOs.Model
@inject ISnackbar Snackbar

<PageTitle>Pessoas</PageTitle>

<div class="page-title">
    <h1>Pessoas</h1>
    <p>Aqui você encontra a lista de pessoas cadastradas em seu sistema</p>
</div>

<div class="notification-menu">
    <div class="filters">
        <div class="option">
            <MudTextField @bind-Value="_personNameFilter" TextChanged="ApplyFilters" Immediate="true" Label="Pessoa" Variant="Variant.Outlined"></MudTextField>
            <MudButton Variant="Variant.Outlined" OnClick=@(() => _personNameFilter = "")>
                <MudIcon Icon="@Icons.Material.Filled.Delete"></MudIcon>
            </MudButton>
        </div>

        <div class="option">
            <MudSelect T="string" SelectedValuesChanged="OnSectorsChanged" SelectedValues="_selectedSectors" MultiSelection="true" SelectAll="true" SelectAllText="Selecionar tudo" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetMultiSelectionText))" Label="Setores" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined">
                @foreach (var sector in _sectors)
                {
                    <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick=@(() => _selectedSectors = Enumerable.Empty<string>())>
                <MudIcon Icon="@Icons.Material.Filled.Delete"></MudIcon>
            </MudButton>
        </div>
    </div>

    <MudButton Variant="Variant.Outlined" OnClick="OpenCreatePerson">Criar pessoa</MudButton>
</div>


<MudTable T="PersonModel" @ref="mudTable" Items="@_filteredPersons" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer" RowClassFunc="@SelectedRowClassFunc" OnRowClick="RowClickEvent">
    <HeaderContent>
        <MudTh>Foto</MudTh>
        <MudTh>Nome</MudTh>
        <MudTh>Setor(es)</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Foto"><MudImage Height="140" Style="border-radius: 7px" src=@($"https://localhost:7010/{context.ImagePath}") /></MudTd>
        <MudTd DataLabel="Nome">@context.Name</MudTd>

        <MudTd DataLabel="Cameras">
            @if (context.Sectors.Count > 0)
            {
                foreach (var sec in context.Sectors)
                {
                    <MudChip T="string" Color="Color.Info">@sec.SectorName</MudChip>
                }
            }
            else
            {
                <MudChip T="string">Nenhum Setor</MudChip>
            }

        </MudTd>
    </RowTemplate>
</MudTable>
