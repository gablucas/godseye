@page "/organizacao/pessoas";
@using GodsEye.Shared.Response.Person
@using GodsEye.WEB.Helpers
@inject ISnackbar Snackbar

<PageTitle>Pessoas</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">
        <div class="page-title">
            <h1>Pessoas</h1>
            <p>Aqui você encontra a lista de pessoas cadastradas em seu sistema</p>
        </div>

        <div class="page-menu">
            <div class="filters">
                <div class="option">
                    <MudTextField @bind-Value="_personNameFilter" TextChanged="ApplyFilters" Immediate="true" Label="Pessoa" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>

                <div class="option">
                    <MudSelect T="string" SelectedValuesChanged="OnSectorsChanged" SelectedValues="_selectedSectors" MultiSelection="true" SelectAll="true" SelectAllText="Selecionar tudo" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetMultiSelectionText))" Label="Setores" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var sector in _sectors)
                        {
                            <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (_persons.Count(x => x.ImagePath == null) > 0)
                {
                    <MudChip 
                        T="string"
                        Label="true"
                        OnClick="FilterPersonsWithNoImage"
                        Variant="!_toggleShowPersonWithNoImage ? Variant.Filled : Variant.Outlined"
                        Style="height: 40px"
                        Color="Color.Error">@(!_toggleShowPersonWithNoImage ? $"Há {_persons.Count(x => x.ImagePath == null)} pessoa(s) sem reconhecimento facial" : "Desfazer filtro")</MudChip>
                }
            </div>

            <MudButton Variant="Variant.Outlined" OnClick="() => DialogWebService.OpenCreatePerson(CreatePersonCallback)">Criar pessoa</MudButton>
        </div>
        <MudTable T="PersonResponse" @ref="mudTable" Elevation="0" Items="@_filteredPersons" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh>Foto</MudTh>
                <MudTh>Nome</MudTh>
                <MudTh>Setor</MudTh>
                <MudTh>Nível de acesso</MudTh>
                <MudTh Style="text-align: center">Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Foto" @onclick="() => DialogWebService.OpenPersonUpdateDialog(context.Id, null)"><MudImage Height="140" Style="border-radius: 7px" src=@(ImageHelper.HasPersonImage(Configuration["ApiUrl"], context.ImagePath)) /></MudTd>
                <MudTd DataLabel="Nome" @onclick="() => DialogWebService.OpenPersonUpdateDialog(context.Id, null)">@context.Name</MudTd>
                <MudTd DataLabel="Setor">@context.Sector.Name</MudTd>
                <MudTd DataLabel="NivelAcesso">@context.AccessLevel.Name</MudTd>

                <MudTd DataLabel="Status">
                    @if (context.ImagePath is not null)
                    {
                        <MudChip T="string"
                            Label="true"
                            Variant="Variant.Outlined"
                            Color="Color.Success"
                        >Ativo</MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 OnClick="() => DialogWebService.OpenCreateRecognizePerson(context.Id, null)"
                                 Label="true"
                                 Variant="Variant.Outlined"
                                 Color="Color.Error">Reconhecimento pendente</MudChip>
                    }
                </MudTd>

            </RowTemplate>
        </MudTable>
    </div>

</div>
