@page "/cadastrar-pessoa"
@using GodsEye.WEB.Enum
@using GodsEye.WEB.Model.Forms
@using Microsoft.AspNetCore.Components.Forms
@using GodsEye.WEB.Components
@inject ISnackbar Snackbar

<PageTitle>Cadastrar pessoa</PageTitle>

<div class="page-title">
    <h1>Cadastrar pessoa</h1>
    <p>Cadastre uma pessoa para utilizar em seu sistema</p>
</div>

<div class="form-container">

    @if (apiResponse is null || (apiResponse is not null && !apiResponse.Sucesso))
    {
        <MudForm @ref="form" Model="PersonModel" @bind-IsValid="@success" @bind-Errors="@errors">

            <div class="inputs-container">

                <MudTextField Label="Nome" @bind-Value="PersonModel.Name" Required="true" RequiredError="O nome é obrigatório" T="string" For="@(() => PersonModel.Name)" Variant="Variant.Outlined" />

                <MudSelect T="string" Label="Setores" HelperText="Selecione o(s) setor(es) que essa pessoa pertence" MultiSelection="true" @bind-SelectedValues="PersonModel.Sectors" MultiSelectionTextFunc="GetSelectedSectorsName" Variant="Variant.Outlined">
                    @foreach (var sector in _sectors)
                    {
                        <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" Label="Sistemas" HelperText="Seleciona os sistemas " MultiSelection="true" @bind-SelectedValues="PersonModel.Sectors" MultiSelectionTextFunc="GetSelectedSectorsName" Variant="Variant.Outlined">
                    @foreach (var sector in _sectors)
                    {
                        <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                    }
                </MudSelect>



             
                <MudDivider Style="margin: 12px 0px" />

                <div class="title">
                    <h2>Insira uma foto</h2>
                    <p>Certifique-se de que a imagem seja de perfil, com uma boa iluminação do rosto.</p>
                </div>

                <div class="person-image">
                    @if (PreviewImage == null && photoMethod == PhotoCaptureMethodEnum.CAMERA)
                    {
                        <div class="image-preview">
                            <video id="video" autoplay playsinline></video>

                            <canvas id="canvas" style="display:none"></canvas>

                            <div class="btns-actions">
                                <MudButton OnClick="@TakePhoto" Variant="Variant.Filled" Color="Color.Primary">Tirar Foto</MudButton>
                                <MudButton Class="back" OnClick="BackToRegister" Variant="Variant.Outlined" Color="Color.Primary">Voltar</MudButton>
                            </div>
                        
                        </div>
                    }
                    else if (PreviewImage == null)
                    {
                        <div class="image-actions">
                            <MudFileUpload T="IBrowserFile" Accept=".png, .jpg" FilesChanged="UploadFile" MaximumFileCount="1" Required="true" RequiredError="A imagem é obrigatória">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="() => photoMethod = PhotoCaptureMethodEnum.IMPORT">
                                        Buscar imagem no computador
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CameraAlt"
                                       OnClick="OpenCamera">
                                Tirar uma foto
                            </MudButton>
                        </div>

                    }
                    else if (PreviewImage != null)
                    {
                        <div class="image-preview">
                            <img Src="@PreviewImage" />
                            <MudButton Class="back" OnClick="BackToRegister" Variant="Variant.Outlined" Color="Color.Primary" Style="padding: 12px">Voltar</MudButton>
                        </div>
                    }

                </div>
            </div>

            <MudDivider />

            <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Registrar</MudButton>

            @if(apiResponse != null)
            {
                if(!apiResponse.Sucesso)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Houve um erro ao cadastrar a pessoa, tente novamente mais tarde</MudAlert>
                }
            }

            <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                <MudProgressCircular Color="Color.Default" Indeterminate="true" />
            </MudOverlay>

        </MudForm>
    } else if (apiResponse is not null && apiResponse.Sucesso) {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Pessoa cadastrada com sucesso!</MudAlert>

        <div class="register-success">
            <img Src="@PreviewImage" />

            <MudList T="string">
                <MudListItem Text="@PersonModel.Name" Icon="@Icons.Material.Filled.Person" />
            </MudList>
        </div>

        <MudButton Class="back" OnClick="BackToRegister" Variant="Variant.Outlined" Color="Color.Primary">Voltar</MudButton>
    }
</div>

