@page "/cadastrar-setor"
@using GodsEye.WEB.Enum
@using GodsEye.WEB.Model.Forms
@using Microsoft.AspNetCore.Components.Forms
@using GodsEye.WEB.Components
@inject ISnackbar Snackbar


<PageTitle>Cadastrar pessoa</PageTitle>

<div class="page-title">
    <h1>Cadastrar setor</h1>
    <p>Cadastre um setor para utilizar em seu sistema</p>
</div>

<div class="form-container">

    @if (apiResponse is null || (apiResponse is not null && !apiResponse.Success))
    {
        <MudForm @ref="form" Model="SectorModel" @bind-IsValid="@success" @bind-Errors="@errors">

            <div class="inputs-container">
                <MudTextField Label="Descrição" @bind-Value="SectorModel.Name" Required="true" RequiredError="O nome é obrigatório" T="string" For="@(() => SectorModel.Name)" Variant="Variant.Outlined" />
            </div>

            <MudDivider />

            <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Registrar</MudButton>


            @if (apiResponse is not null && !apiResponse.Success)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Houve um erro ao cadastrar a pessoa, tente novamente mais tarde</MudAlert>
            }


            <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                <MudProgressCircular Color="Color.Default" Indeterminate="true" />
            </MudOverlay>

        </MudForm>
    }
    else if (apiResponse is not null && apiResponse.Success)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Setor cadastrado com sucesso!</MudAlert>

        <div class="register-success">

            <MudList T="string">
                <MudListItem Text="@SectorModel.Name" Icon="@Icons.Material.Filled.CameraAlt" />
            </MudList>
        </div>

        <MudButton Class="back" OnClick="BackToRegister" Variant="Variant.Outlined" Color="Color.Primary">Voltar</MudButton>
    }
</div>

