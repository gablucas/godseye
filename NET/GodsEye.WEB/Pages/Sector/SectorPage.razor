@page "/organizacao/setores";
@using GodsEye.WEB.Components.SectorComponents
@inject ISnackbar Snackbar

<PageTitle>Setores</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">

        <div class="page-title">
            <h1>Setores</h1>
            <p>Aqui você encontra uma lista de setores cadastrados em seu sistema</p>
        </div>


        <MudTreeView T="int"
                        Hover="true"
                        Dense="true"
                        ReadOnly>

            @foreach (var sector in _sectors)
            {
                <div class="sector-tree-main">
                    <SectorNode Item="sector" />
                    <MudButton Variant="Variant.Outlined" Style="margin-left: 32px;" OnClick="() => DialogWebService.OpenCreateSector(sector.Id)">Criar Setor</MudButton>
                </div>
            }

            <MudButton Variant="Variant.Outlined" OnClick="() => DialogWebService.OpenCreateSector()">Criar Setor</MudButton>
        </MudTreeView>

    </div>

    
</div>

