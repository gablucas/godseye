@page "/cadastrar-camera"
@using GodsEye.WEB.Enum
@using GodsEye.WEB.Model.Forms
@using Microsoft.AspNetCore.Components.Forms
@using GodsEye.WEB.Components
@inject ISnackbar Snackbar


<PageTitle>Cadastrar camera</PageTitle>

<div class="page-title">
    <h1>Cadastrar camera</h1>
    <p>Cadastre uma camera para utilizar em seu sistema</p>
</div>

<div class="form-container">

    @if (apiResponse is null || (apiResponse is not null && !apiResponse.Success))
    {
        <MudForm @ref="form" Model="CameraModel" @bind-IsValid="@success" @bind-Errors="@errors">

            <div class="inputs-container">

                <MudTextField Label="Descrição" @bind-Value="CameraModel.Name" Required="true" RequiredError="O nome é obrigatório" T="string" For="@(() => CameraModel.Name)" Variant="Variant.Outlined" />
                <MudTextField Label="Conexão" HelperText="IP de conexão para se conectar a camera" @bind-Value="CameraModel.Connection" T="string" Variant="Variant.Outlined" />

                <MudSelect T="string" Clearable="true" Label="Selecione um setor" @bind-Value="CameraModel.SectorId" Required="true" RequiredError="Selecione um setor" Variant="Variant.Outlined">
                    @foreach (var sector in _sectors)
                    {
                        <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudDivider Style="margin: 24px 0px" />

            <MudText Typo="Typo.h6">Funcionalidades Disponíveis</MudText>
            <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary"> Selecione no mínimo uma funcionalidade para esta camera</MudText>

            <div class="feature-container">
                @foreach (var feature in _features)
                {
                    <div class="feature">
                        <MudCheckBox T="bool"
                                        Value="@(CameraModel.Features.Contains(feature.Id))"
                                        ValueChanged="@((bool isChecked) => OnFeatureToggled(feature.Id, isChecked))"
                                        Label="@feature.Name"
                                        Color="Color.Primary"
                                        Dense="true"

                                        />

                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @feature.Description
                        </MudText>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(featureError))
            {
                <MudText Color="Color.Error" Typo="Typo.caption">
                    @featureError
                </MudText>
            }


            <MudButton OnClick="Submit" Disabled=@(!success || !ValidateFeatures()) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Registrar</MudButton>


            @if (apiResponse is not null && !apiResponse.Success)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Houve um erro ao cadastrar a pessoa, tente novamente mais tarde</MudAlert>
            }
            

            <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
                <MudProgressCircular Color="Color.Default" Indeterminate="true" />
            </MudOverlay>

        </MudForm>
    }
    else if (apiResponse is not null && apiResponse.Success)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Camera cadastrada com sucesso!</MudAlert>

        <div class="register-success">

            <MudList T="string">
                <MudListItem Text="@CameraModel.Name" Icon="@Icons.Material.Filled.CameraAlt" />
            </MudList>
        </div>

        <MudButton Class="back" OnClick="BackToRegister" Variant="Variant.Outlined" Color="Color.Primary">Voltar</MudButton>
    }
</div>

