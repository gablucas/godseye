@page "/camera/{Id:int}/monitoramento-ambiente"
@using GodsEye.WEB.Components.CameraComponents
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<PageTitle>Monitoramento de ambiente</PageTitle>

<div class="page-title">
    <h1>Monitoramento de ambiente</h1>
    <p>Configure a funcionalidade de monitoramento de ambiente</p>
</div>

<CameraConfigurationBarComponent Id="Id" Pagina="monitoramento-ambiente" />


<div class="form-container">

    <MudForm @ref="form" Model="DwellTimeMonitoringForm" @bind-IsValid="@success" @bind-Errors="@errors">

        <MudTextField Label="Tempo máximo de permanência"
                      HelperText="Tempo máximo que a pessoa pode permanecer no ambiente antes de gerar um alerta"
                      @bind-Value="DwellTimeMonitoringForm.MaxDwellTime"
                      T="int"
                      For="@(() => DwellTimeMonitoringForm.MaxDwellTime)"
                      Variant="Variant.Outlined" />

        <MudTextField Label="Tolerância sem identificação"
                      HelperText="Tempo máximo que a pessoa pode ficar sem ser identificada pela câmera antes de gerar um alerta"
                      @bind-Value="DwellTimeMonitoringForm.RecognitionGracePeriod"
                      T="int"
                      For="@(() => DwellTimeMonitoringForm.RecognitionGracePeriod)"
                      Variant="Variant.Outlined" />

        <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Atualizar</MudButton>

        <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        </MudOverlay>

    </MudForm>

</div>