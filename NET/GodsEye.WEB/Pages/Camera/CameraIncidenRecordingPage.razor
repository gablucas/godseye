@page "/camera/{Id:int}/registro-incidente"
@using GodsEye.WEB.Components.CameraComponents
@using GodsEye.WEB.Enum
@inject ISnackbar Snackbar

<PageTitle>Registro de incidente</PageTitle>

<div class="page-title">
    <h1>Registro de incidencia</h1>
    <p>Configure a funcionalidade de registro de incidente</p>
</div>

<CameraConfigurationBarComponent Id="Id" Pagina="registro-incidente" />


<div class="form-container">

    <MudForm @ref="form" Model="IncidentRecordingForm" @bind-IsValid="@success" @bind-Errors="@errors">

        <div>
            <MudText Typo="Typo.subtitle2">Identificador da camera</MudText>
            <MudTextField Style="width: 400px" Label="MacAddress" @bind-Value="IncidentRecordingForm.MacAddress" T="string" For="@(() => IncidentRecordingForm.MacAddress)" Variant="Variant.Outlined" />
        </div>

        <div class="email-container">
            <MudText Typo="Typo.subtitle2">Defina os emails que receberão o aviso da incidencia</MudText>

            <div class="email-input">
                <MudTextField T="string"
                      ValueChanged="OnEmailChanged"
                      Label="Email"
                      Variant="Variant.Outlined"
                      Style="width: 400px"
                      Error="@_hasEmailError"
                      ErrorText="@_emailErrorMessage" />

                <MudButton OnClick="AddEmail" Style="height: 56px; margin-top: 8px" Variant="Variant.Outlined" Color="Color.Success">Adicionar email</MudButton>
            </div>

            <div class="email-list">
                @foreach (var email in IncidentRecordingForm.Emails)
                {
                    <MudChip T="string" Label="true" Variant="Variant.Outlined" Size="Size.Large" Color="Color.Primary" OnClose="() => RemoveEmail(email)">@email</MudChip>
                }
            </div>
        </div>

        <MudButton OnClick="Submit" Disabled=@(!success) Class="btn-submit" Variant="Variant.Filled" Color="Color.Primary">Atualizar</MudButton>

        <MudOverlay Visible="visible" LightBackground="true" Absolute="true">
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        </MudOverlay>

    </MudForm>

</div>