@page "/compliance/violacoes";
@using GodsEye.Shared.Enums
@using GodsEye.Shared.Extensions
@using GodsEye.Shared.Response.Compliance
@using GodsEye.Shared.Response.Sector
@using GodsEye.WEB.Components.Compliance
@using GodsEye.WEB.Components.FilterComponents
@using GodsEye.WEB.Components.TableHelpers
@using GodsEye.WEB.Services
@using GodsEye.WEB.Shared


<PageTitle>Políticas</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_breadCrumb"></MudBreadcrumbs>
    </div>

    <div class="content-container">
        <div class="page-title">
            <h1>Violações</h1>
        </div>

        <div class="violations-bar">
            <div class="item @(IsMenuSelected(null))" @onclick="() => SelectMenuOption(null)">
                <span>Geral</span>
            </div>

            <div class="item @(IsMenuSelected(CompliancePolicyEnum.SECTOR_TRANSITION))" @onclick="() => SelectMenuOption(CompliancePolicyEnum.SECTOR_TRANSITION)">
                <span>Transição de setores</span>
            </div>
        </div>

        
        @switch(_selectedMenu)
        {
            case null:
                <ViolationTable />
                break;
            case CompliancePolicyEnum.SECTOR_TRANSITION:
                <SectorTransitionViolationTable />
                break;
        }
    </div>
</div>