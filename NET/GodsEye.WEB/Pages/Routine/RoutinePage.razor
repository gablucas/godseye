@page "/organizacao/rotinas";
@using GodsEye.Domain.Extensions
@inject ISnackbar Snackbar

<PageTitle>Rotinas</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">

        <div class="page-title">
            <h1>Rotinas</h1>
            <p>Aqui você encontra uma lista das rotinas cadastradas em seu sistema</p>
        </div>

        <div class="notification-menu">
            <div class="filters">
                <div class="option">
                    <MudTextField @bind-Value="_routineFilterName" TextChanged="ApplyFilters" Immediate="true" Label="Rotina" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>
            </div>

            <MudButton Variant="Variant.Outlined" OnClick="() => DialogWebService.OpenHandleRoutine()">Criar Rotina</MudButton>
        </div>

        <MudTable @ref="mudTable" Items="@_filteredRoutines" Hover="true" Loading="@_loading" Elevation="0" LoadingProgressColor="Color.Info" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Regra</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name" @onclick="() => DialogWebService.OpenHandleRoutine(context.Id)">@context.Name</MudTd>
                <MudTd DataLabel="Type">@context.Type.GetDescription()</MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    
</div>

