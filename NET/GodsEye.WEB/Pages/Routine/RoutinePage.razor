@page "/organizacao/rotinas";
@inject ISnackbar Snackbar

<PageTitle>Setores</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">

        <div class="page-title">
            <h1>Setores</h1>
            <p>Aqui você encontra uma lista de setores cadastrados em seu sistema</p>
        </div>

        <div class="notification-menu">
            <div class="filters">
                <div class="option">
                    <MudTextField @bind-Value="_sectorNameFilter" TextChanged="ApplyFilters" Immediate="true" Label="Setor" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>

                <div class="option">
                    <MudSelect T="string" SelectedValuesChanged="OnCamerasChanged" SelectedValues="_selectedCameras" MultiSelection="true" SelectAll="true" SelectAllText="Selecionar tudo" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetMultiSelectionText))" Label="Cameras" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var camera in _camerasFilter)
                        {
                            <MudSelectItem T="string" Value="@camera.Id.ToString()">@camera.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>

            <MudButton Variant="Variant.Outlined" OnClick="() => DialogWebService.OpenCreateRoutine(CraeteRoutineCallback)">Criar Setor</MudButton>
        </div>

        <MudTable Items="@_filteredSectors" Hover="true" Loading="@_loading" Elevation="0" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Cameras vinculadas</MudTh>
                <MudTh>Grupos de notificação</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Cameras">
                    @if (context.Cameras.Count > 0)
                    {
                        foreach (var cam in context.Cameras)
                        {
                            <MudChip Color="Color.Info" T="string">@cam.Name</MudChip>
                        }
                    } 
                    else
                    {
                        <MudChip T="string">Sem cameras</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="NotificationGroups">
                    @if (context.NotificationGroups.Count > 0)
                    {
                        foreach (var notificationGroup in context.NotificationGroups)
                        {
                            <MudChip Color="Color.Info" T="string">@notificationGroup.Name</MudChip>
                        }
                    }
                    else
                    {
                        <MudChip T="string">Sem grupo</MudChip>
                    }
                </MudTd>

            </RowTemplate>
        </MudTable>
    </div>

    
</div>

