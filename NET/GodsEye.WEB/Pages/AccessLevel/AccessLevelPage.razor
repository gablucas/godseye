@page "/organizacao/nivel-de-acesso";
@using GodsEye.Shared.Enums
@using GodsEye.Shared.Response
@using GodsEye.Shared.Response.AccessLevel
@inject ISnackbar Snackbar

<PageTitle>Nível de acesso</PageTitle>

<div class="page-container">
    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">
        <div class="page-title">
            <h1>Nível de acesso</h1>
        </div>

        <div class="page-menu">
            <div class="filters">
                <div class="option">
                    <MudTextField @bind-Value="_personNameFilter" TextChanged="ApplyFilters" Immediate="true" Label="Pessoa" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>

                <div class="option">
                    <MudSelect T="string" SelectedValuesChanged="OnSectorsChanged" SelectedValues="_selectedSectors" MultiSelection="true" SelectAll="true" SelectAllText="Selecionar tudo" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetMultiSelectionText))" Label="Setores" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var sector in _sectors)
                        {
                            <MudSelectItem T="string" Value="@sector.Id.ToString()">@sector.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>

            <MudButton Variant="Variant.Outlined" OnClick="() => DialogWebService.OpenCreateAcessLevel(CreateAccessLevelCallback)">Criar nível de acesso</MudButton>
        </div>


        <MudTable T="AccessLevelResponse" @ref="mudTable" Elevation="0" Items="@_filteredAccessLevel" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer" RowClassFunc="@SelectedRowClassFunc" OnRowClick="RowClickEvent">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Setores permitidos</MudTh>
                <MudTh>Setores proibidos</MudTh>
                <MudTh>Calendário de acesso</MudTh>
                <MudTh>Configurações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nome">@context.Name</MudTd>
                <MudTd DataLabel="Setores permitidos">@context.Sectors.Count(x => x.RuleType == AccessLevelSectorRuleEnum.PROHIBITED)</MudTd>
                <MudTd DataLabel="Setores proibidos">@context.Sectors.Count(x => x.RuleType == AccessLevelSectorRuleEnum.BLACKLIST)</MudTd>
                <MudTd DataLabel="Nome">@context.SectorSchedule.Name</MudTd>
                <MudTd>
                    <MudButton OnClick="() => OpenEditData(context.Id)" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Configurações</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>

</div>
