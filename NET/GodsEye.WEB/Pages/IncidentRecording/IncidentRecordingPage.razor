@page "/monitoramento/captura-incidentes"
@using GodsEye.Application.DTOs.Model

<div class="page-container">

    <div class="breadcrumb-container">
        <MudBreadcrumbs Style="padding: 8px 0px; font-size: 12px; font-weight: 500" Items="_items"></MudBreadcrumbs>
    </div>

    <div class="content-container">
        <div class="page-title">
            <h1>Registro de incidencia</h1>
        </div>

        <MudTable T="IncidentRecordingModel" @ref="mudTable" Items="@_log" Hover="true" Elevation="0" Loading="@_loading" LoadingProgressColor="Color.Info" RowClass="cursor-pointer" RowClassFunc="@SelectedRowClassFunc" OnRowClick="RowClickEvent">
            <HeaderContent>
                <MudTh>Setor</MudTh>
                <MudTh>Data/Hora do Incidente</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Pessoas Identificadas</MudTh>
                @* <MudTh>Ver detalhes</MudTh> *@
            </HeaderContent>
            <RowTemplate>
                @* <MudTd DataLabel="PersonPhoto"><MudImage Height="160" Style="border-radius: 7px" src=@($"https://localhost:7010/{context.PersonPhoto}") /></MudTd>
        <MudTd DataLabel="Person">@context.Person</MudTd> *@
                <MudTd DataLabel="Name">@context.Sector</MudTd>
                <MudTd DataLabel="IncidentTime">@context.IncidentTime</MudTd>
                <MudTd DataLabel="IncidentTime">@context.Status</MudTd>
                <MudTd DataLabel="QuantityPerson">@context.Persons.Count()</MudTd>
                @* <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small">Ver Detalhes</MudButton></MudTd> *@
            </RowTemplate>
        </MudTable>
    </div>
</div>

